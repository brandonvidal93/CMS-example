# Dependencias: se reinstalan con "npm run install:all"
node_modules/

# Compilados y cachés
dist/
.angular/
*.tsbuildinfo
coverage/

# Base de datos local y sus respaldos: es contenido, no código
*.db
*.db-journal
*.db-wal
*.db-shm

# Variables de entorno (claves, contraseñas)
.env
.env.*

# Logs
*.log
npm-debug.log*

# Sistema y editores (web/.vscode sí se sube: trae la configuración recomendada de Angular)
.DS_Store
Thumbs.db
.idea/
.qodo/
/.vscode/
