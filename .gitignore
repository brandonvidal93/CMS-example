# Dependencias: se reinstalan con "npm install" (y better-sqlite3 se compila para cada sistema)
node_modules/

# Base de datos local y sus respaldos: es contenido, no código
*.db
*.db-journal
*.db-wal
*.db-shm

# Variables de entorno (por si en el futuro añades claves o contraseñas)
.env
.env.*

# Logs
*.log
npm-debug.log*

# Archivos del sistema y de editores
.DS_Store
Thumbs.db
.vscode/
.idea/
.qodo/
